{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "itinerary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": { "type": "string" },
          "activity": { "type": "string" },
          "persona_match_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "dynamic_adjustment_reason": { "type": "string" },
          "reasoning_trace": { "type": "string" }
        },
        "required": ["location", "activity", "persona_match_score", "reasoning_trace"]
      }
    }
  },
  "required": ["itinerary"]
}
